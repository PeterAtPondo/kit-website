{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.kit-project.com"
        }
      ],
      "destination": "https://kit-project.com/:path",
      "permanent": true
    },
    {
      "source": "/ui/docs/recall-proof.html",
      "destination": "https://demo.kit-project.com/ui/docs/recall-proof.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/beta",
      "destination": "/api/beta-roster"
    }
  ],
  "buildCommand": "node scripts/sync-navigation.mjs --check",
  "outputDirectory": "."
}
